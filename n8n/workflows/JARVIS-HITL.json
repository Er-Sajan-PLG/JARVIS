      "id": "fb3a1f1a-8154-4b5c-a500-2d8396c27641",
      "name": "Poll Pending",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        0
      ],
      "disabled": false,
      "credentials": {}
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8000/api/v1/hitl/pending",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "df552670-74d2-478f-9d7e-e776275d56ec",
      "name": "Fetch Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "disabled": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kc1CtJNNwhWnTeP0",
          "name": "jarvis-api-auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = items[0].json;\nconst pendings = response.pending || [];\nconst out = [];\n\nfor (const p of pendings) {\n  // notified_at is owned by JARVIS, so a re-poll cannot re-announce (and it survives\n  // n8n restarts, unlike workflow static data).\n  if (p.notified_at) continue;\n  out.push({ json: {\n    planId: p.plan_id,\n    stepId: p.step_id,\n    tool: p.tool_name,\n    tier: p.safety_tier,\n    reason: p.description || 'No reason provided'\n  }});\n}\n\nreturn out;"
      },
      "id": "41f742db-c671-49f1-9ea7-6f5068100b8f",
      "name": "Split New Pendings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        200,
        0
      ],
      "disabled": false,
      "credentials": {}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({channel: 'C0C0UPLGY12', text: `JARVIS HITL Request\\n\\nPlan: ${$json.planId}\\nStep: ${$json.stepId}\\nTool: ${$json.tool}\\nTier: ${$json.tier}\\n\\n${$json.reason}\\n\\nTo approve:\\ncurl -X POST http://127.0.0.1:8000/api/v1/hitl/approve -H \\\"Authorization: Bearer $JARVIS_API_KEY\\\" -d '{\\\"plan_id\\\":\\\"${$json.planId}\\\",\\\"step_id\\\":\\\"${$json.stepId}\\\",\\\"decision\\\":\\\"approve\\\"}'` }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "slack-notify",
      "name": "Notify Slack (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "82c4yvpRwbN8MMCM",
          "name": "slack-bot-auth"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "replyMarkup": {
          "inlineKeyboard": [
            [
              {
                "text": "Approve",
                "callbackData": "hitl_approve_{{ $json.planId }}"
              },
              {
                "text": "Deny",
                "callbackData": "hitl_deny_{{ $json.planId }}"
              }
            ]
          ]
        },
        "options": {
          "parseMode": "Markdown"
        }
      },
      "id": "telegram-notify",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        600,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "Lp7660U6W0ypdKBc",
          "name": "telegram-credentials"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "path": "hitl/callback",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d68bd735-f711-40f3-bc71-c05e7c068c83",
      "name": "Approval Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -200,
        300
      ],
      "disabled": false,
      "credentials": {},
      "webhookId": "41535a7b-ca77-4017-a2cb-37ecaaf88109"
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json;\n// Webhook nodes wrap the payload: { headers, params, query, body }\nconst callback = raw.body || raw;\n\nconst planId = callback.plan_id || callback.planId;\nconst stepId = callback.step_id || callback.stepId;\nconst decisionRaw = callback.decision !== undefined\n  ? callback.decision\n  : (callback.approved === true ? 'approve' : 'deny');\nconst decision = String(decisionRaw).toLowerCase();\n\nif (!planId || !stepId) {\n  throw new Error(`Invalid callback: missing plan_id or step_id (keys: ${Object.keys(callback)})`);\n}\nif (decision !== 'approve' && decision !== 'deny') {\n  throw new Error(`Invalid callback: decision must be 'approve' or 'deny', got '${decision}'`);\n}\n\nreturn [{\n  json: {\n    planId,\n    stepId,\n    decision,\n    approver: callback.approver || 'n8n:callback',\n    decidedAt: new Date().toISOString()\n  }\n}];",
        "mode": "runOnceForAllItems"
      },
      "id": "parse-callback",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8000/api/v1/hitl/approve",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({plan_id: $json.planId, step_id: $json.stepId, decision: $json.decision, approver: $json.approver }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
