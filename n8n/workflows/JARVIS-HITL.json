    {
      "parameters": {
        "url": "http://127.0.0.1:8000/api/v1/hitl/pending",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "e825151c-b96d-4e17-8f1a-899914322650",
      "name": "Fetch Pending (Timeout)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        600
      ],
      "disabled": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kc1CtJNNwhWnTeP0",
          "name": "jarvis-api-auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cutoffMs = 30 * 60 * 1000;\nconst now = Date.now();\nconst response = items[0].json;\nconst out = [];\n\nfor (const p of (response.pending || [])) {\n  const requested = Date.parse(p.requested_at);\n  if (!Number.isNaN(requested) && now - requested > cutoffMs) {\n    out.push({ json: { planId: p.plan_id, stepId: p.step_id } });\n  }\n}\n\nreturn out;"
      },
      "id": "2fce312b-0b35-483a-9476-751e7a9f91b4",
