{
  "name": "JARVIS-HITL",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hitl",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-hitl",
      "name": "HITL Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "jarvis-hitl"
    },
    {
      "parameters": {
        "functionCode": "const payload = items[0].json;\n\nconst planId = payload.plan_id || payload.planId;\nconst stepId = payload.step_id || payload.stepId;\nconst tool = payload.tool_name || payload.tool || 'unknown';\nconst tier = payload.safety_tier || 'destructive';\nconst reason = payload.description || payload.reason || 'No reason provided';\n\nif (!planId || !stepId) {\n  throw new Error('HITL payload must include plan_id and step_id');\n}\n\nconst message = `JARVIS HITL Request\n\nPlan: ${planId}\nStep: ${stepId}\nTool: ${tool}\nTier: ${tier}\nReason: ${reason}\n\nAction required: Approve or Deny within 30 minutes.`;\n\nreturn [{\n  json: { planId, stepId, tool, tier, reason, message, timestamp: new Date().toISOString() }\n}];"
      },
      "id": "format-notification",
      "name": "Format Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "text": "={{ $json.message }}",
        "blocksUi": {
          "blocks": [
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "={{ $json.message }}"
              }
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "Approve",
                    "emoji": true
                  },
                  "style": "primary",
                  "value": "approve",
                  "action_id": "hitl_approve"
                },
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "Deny",
                    "emoji": true
                  },
                  "style": "danger",
                  "value": "deny",
                  "action_id": "hitl_deny"
                }
              ]
            }
          ]
        },
        "options": {},
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C0C0UPLGY12",
          "mode": "id"
        }
      },
      "id": "slack-notify",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        750,
        200
      ],
      "credentials": {
        "slackApi": {
          "id": "lMrhAP6nzQjAyQVF",
          "name": "slack-credentials"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "replyMarkup": {
          "inlineKeyboard": [
            [
              {
                "text": "Approve",
                "callbackData": "hitl_approve_{{ $json.approvalId }}"
              },
              {
                "text": "Deny",
                "callbackData": "hitl_deny_{{ $json.approvalId }}"
              }
            ]
          ]
        },
        "options": {
          "parseMode": "Markdown"
        }
      },
      "id": "telegram-notify",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        750,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "Lp7660U6W0ypdKBc",
          "name": "telegram-credentials"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "return items;"
      },
      "id": "wait-approval",
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hitl/callback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-callback",
      "name": "Approval Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ],
      "webhookId": "jarvis-hitl-callback"
    },
    {
      "parameters": {
        "functionCode": "const callback = items[0].json;\n\nconst planId = callback.plan_id || callback.planId;\nconst stepId = callback.step_id || callback.stepId;\nconst raw = callback.decision !== undefined\n  ? callback.decision\n  : (callback.approved === true ? 'approve' : 'deny');\nconst decision = String(raw).toLowerCase();\n\nif (!planId || !stepId) {\n  throw new Error('Invalid callback: missing plan_id or step_id');\n}\nif (decision !== 'approve' && decision !== 'deny') {\n  throw new Error(\"Invalid callback: decision must be 'approve' or 'deny'\");\n}\n\nreturn [{\n  json: {\n    planId,\n    stepId,\n    decision,\n    approver: callback.approver || 'n8n:callback',\n    decidedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "parse-callback",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8000/api/v1/hitl/approve",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "bodyParametersJson": "{\n  \"plan_id\": \"={{ $json.planId }}\",\n  \"step_id\": \"={{ $json.stepId }}\",\n  \"decision\": \"={{ $json.decision }}\",\n  \"approver\": \"={{ $json.approver }}\"\n}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "jarvis-callback",
      "name": "Callback to JARVIS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1750,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kc1CtJNNwhWnTeP0",
          "name": "jarvis-api-auth"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const result = items[0].json;\n\nreturn [{\n  json: {\n    plan_id: result.planId,\n    step_id: result.stepId,\n    decision: result.decision,\n    message: result.decision === 'approve'\n      ? 'Approved - execution resumed'\n      : 'Denied - execution halted',\n    decided_at: result.decidedAt\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Callback",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2250,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const formatted = $('Format Notification').item.json;\n\nreturn [{\n  json: {\n    planId: formatted.planId,\n    stepId: formatted.stepId,\n    decision: 'deny',\n    approver: 'n8n:timeout',\n    reason: 'Timeout - auto-denied after 30 minutes',\n    decidedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "auto-deny",
      "name": "Auto-Deny (Timeout)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1000,
        500
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8000/api/v1/hitl/approve",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "bodyParametersJson": "{\n  \"plan_id\": \"={{ $json.planId }}\",\n  \"step_id\": \"={{ $json.stepId }}\",\n  \"decision\": \"deny\",\n  \"approver\": \"n8n:timeout\",\n  \"reason\": \"Timeout - auto-denied after 30 minutes\"\n}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "timeout-callback",
      "name": "Timeout Callback to JARVIS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1250,
        500
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kc1CtJNNwhWnTeP0",
          "name": "jarvis-api-auth"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    approval_id: \"={{ $('Format Notification').item.json.approvalId }}\",\n    approved: false,\n    message: 'Auto-denied after 30 minutes timeout',\n    decided_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "timeout-response",
      "name": "Timeout Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1500,
        500
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {}
      },
      "id": "timeout-webhook-response",
      "name": "Timeout Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1750,
        500
      ]
    }
  ],
