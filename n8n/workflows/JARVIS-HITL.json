      "name": "Callback to JARVIS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kc1CtJNNwhWnTeP0",
          "name": "jarvis-api-auth"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {}
