# JARVIS Environment Configuration

Copy this file to `.env` and fill in the values you need. Only the variables
you actually use are required. **Never commit the real `.env`.**

## Required (v3.0 runtime)

# Single-tenant Bearer token for the HTTP/WS adapters.
# Generate: openssl rand -hex 32
JARVIS_API_KEY=

## LLM providers (fill only the ones you use)

# OpenRouter
OPENROUTER_API_KEY=
# xAI / Grok
XAI_API_KEY=
# Google AI Studio (Gemini)
GOOGLE_API_KEY=
# Groq
GROQ_API_KEY=
# Cerebras
CEREBRAS_API_KEY=
# SambaNova
SAMBANOVA_API_KEY=
# NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_API_KEY=
# Singularity
SINGULARITY_API_KEY=
# Qwen
QWEN_API_KEY=
# OpenCode
OPENCODE_API_KEY=
# UniRouter / TokenRouter / TokenHarbour
UNOROUTER_API_KEY=
TOKENROUTER_API_KEY=
TOKENHARBOUR_API_KEY=
# Exa (search)
EXA_API_KEY=
# Web search plugin (Migration Step 2): set to 1 to register web_search in DEFAULT_TOOLSET
JARVIS_WEB_SEARCH=0
# Xkiro
XKIRO_API_KEY=
# Chutes
CHUTES_AI_KEY=
CHUTES_AI_FINGLERPRINT=
# Reqwesty
REQUESTY_API_KEY=
# Cloudflare (deploy)
CF_API_KEY=
# HuggingFace catalog endpoint (ARCH-007: externalised from source)
HF_API_URL=https://huggingface.co/api/models
# Learning Commons
LEARNING_COMMONS_API_KEY=

## OAuth (optional, for remote OCR / integrations)
CLIENT_ID=
CLIENT_SECRET=

## N8N / Workflow automation (Sprint 3+ — n8n handles checks via execution plane)
MCP_N8N_OFFICIAL_API_KEY=
GITHUB_MCP_PAT=

## Comms — push (Web Push, no extra setup; keys already issued)
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com

## Comms — email (Gmail: address + app password, not the login password)
# JARVIS_EMAIL_ADDRESS=
# JARVIS_EMAIL_PASSWORD=
# JARVIS_EMAIL_IMAP_HOST=imap.gmail.com
# JARVIS_EMAIL_SMTP_HOST=smtp.gmail.com

## Comms — morning brief (delivered on demand + via n8n schedule)
# JARVIS_BRIEF_ENABLED=true
# JARVIS_BRIEF_TIME=08:00
# JARVIS_BRIEF_DELIVERY=push
# JARVIS_BRIEF_EMAIL=

## Comms — Telegram two-way bot (send alerts + chat; poller starts with server)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ENABLED=true

## Comms — WhatsApp Cloud API, send-only (needs Meta app + number migration)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TO=9779768021317
# WHATSAPP_TEMPLATE=hello_world
# WHATSAPP_ENABLED=true

## Orchestration — sub-agent workers (see docs/TOOLS.md, ADR-017)
# JARVIS_SUBAGENTS=build,plan,general
# OPENCODE_BIN=

## CORS (optional — comma-separated origins)
# CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

## Mobile / network access (see docs/MOBILE_ACCESS.md)
## The exact URL a phone opens, so a tunnel hostname is allowlisted. No trailing slash.
# JARVIS_PUBLIC_ORIGIN=http://jarvis-host:8000
## Bind address. Defaults to 0.0.0.0 so other devices can reach the server.
## Set to 127.0.0.1 to restrict access to this machine only.
# JARVIS_HOST=0.0.0.0
# JARVIS_PORT=8000
