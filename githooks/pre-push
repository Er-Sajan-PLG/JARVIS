#!/usr/bin/env bash
# JARVIS pre-push hook — BLOCKING doc gates, then release tagging.
#
# Order matters: documentation truth is verified BEFORE anything leaves the
# machine. Any gate failure exits non-zero and the push is refused. No
# bypass flag exists on purpose — fix the docs, then push.
#
# Gates (all must pass):
#   1. scripts/check_docs.py --strict      (structure: headers, types, paths)
#   2. scripts/check_doc_coverage.py --strict (coverage: modules, routes, env)
#   3. tests/unit/test_doc_coverage.py     (gate pinned by tests)
#
# Then the original behaviour: auto-tag a SemVer release on the default branch.
#
# Installed via:  python scripts/bump_version.py install-hooks
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PY="$REPO_ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || true)"

echo "🔒 JARVIS pre-push: documentation gates (push blocked on failure)…"
GATE_FAIL=0
"$PY" "$REPO_ROOT/scripts/check_docs.py" --strict || GATE_FAIL=1
"$PY" "$REPO_ROOT/scripts/check_doc_coverage.py" --strict || GATE_FAIL=1
"$PY" -m pytest "$REPO_ROOT/tests/unit/test_doc_coverage.py" -q || GATE_FAIL=1

if [ "$GATE_FAIL" -ne 0 ]; then
  echo ""
  echo "❌ push refused: documentation gates failed. Fix the docs above, then push again."
  exit 1
fi
echo "✅ doc gates passed."
#
# Safety / rationale:
#   * The tag is created from an already-committed bump (the hook does NOT commit
#     on your behalf mid-push); it just materialises the release marker for the
#     commits you are about to push.
#   * version_bump.py --apply commits the pyproject metadata bump and tags, so
#     the derived version (git describe) and the metadata agree.
#   * The hook never blocks the push on failure: if the version bump cannot be
#     computed, it warns and lets the push proceed (same "informational" posture
#     as before, but now WITH an automatic tag when it can).
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PY="$(command -v python3 || true)"
DEFAULT_BRANCH="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
  | sed 's@^refs/remotes/origin/@@' || echo main)"

# Is the venv python available? Prefer it so the module's cwd maths hold.
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
  PY="$REPO_ROOT/.venv/bin/python"
fi

while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  branch="${local_ref#refs/heads/}"
  [ "$branch" = "$DEFAULT_BRANCH" ] || continue

  latest="$(git -C "$REPO_ROOT" describe --tags --abbrev=0 \
    --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
  [ -n "$latest" ] || continue

  ahead="$(git -C "$REPO_ROOT" rev-list --count "${latest}..HEAD" 2>/dev/null || echo 0)"

  if [ "$ahead" -gt 0 ] && [ -n "$PY" ]; then
    echo "🔖 Pushing '$branch', $ahead commit(s) ahead of '$latest' — auto-tagging…"
    if (cd "$REPO_ROOT" && "$PY" scripts/version_bump.py --apply --tag-only); then
      echo "   ✅ release tag created (see git tag)."
      # A tag is not a release: GitHub showed 21 tags and 0 releases, so notes,
      # compare links and the "Latest" marker never existed. Actions is
      # billing-blocked, so publish locally via gh (the CI token lacks
      # contents:write; gh holds a repo-scoped token that can).
      #
      # ORDERING: we are inside pre-push, so the tag is not on the remote yet and
      # gh refuses to release an unpushed tag. Push the tag explicitly first.
      # Pushing a tag re-enters this hook with local_ref=refs/tags/... which the
      # branch guard below skips, so there is no recursion.
      new_tag="$(git -C "$REPO_ROOT" describe --tags --abbrev=0 \
        --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
      tag_pushed=0
      if [ -n "$new_tag" ]; then
        if git -C "$REPO_ROOT" push --quiet origin "refs/tags/$new_tag" 2>/dev/null; then
          tag_pushed=1
        elif git -C "$REPO_ROOT" ls-remote --exit-code --tags origin "refs/tags/$new_tag" \
          >/dev/null 2>&1; then
          tag_pushed=1   # already on the remote from a previous attempt
        fi
      fi
      if [ "$tag_pushed" -eq 1 ]; then
        if (cd "$REPO_ROOT" && "$PY" scripts/publish_release.py); then
          echo "   ✅ GitHub release published."
        else
          echo "   ⚠️  could not publish a GitHub release (tag is pushed; rerun scripts/publish_release.py)."
        fi
      else
        echo "   ⚠️  tag not on the remote yet — release publish skipped (push tags, then run scripts/publish_release.py)."
      fi
    else
      echo "   ⚠️  could not auto-tag (see above); push continues untagged."
    fi
  fi
done

exit 0
