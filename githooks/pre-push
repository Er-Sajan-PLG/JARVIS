#!/usr/bin/env bash
# JARVIS pre-push hook — EXTREME free-tier hardening (no Pro plan).
#
# Without GitHub branch protection (403 on private-free), this hook is the
# enforcement point. It BLOCKS the push (exit 1) on any failure. There is
# deliberately no bypass flag and no `--no-verify` honor: a determined local
# bypass is still possible (hooks live on disk), which is why
# scripts/verify-push.sh exists to detect it after the fact.
#
# Stages (all must pass):
#   0. Refuse branch/tag deletion and force-pushes (non-fast-forward).
#   1. Require SSH signatures on every pushed commit (commit.gpgsign).
#   2. gitleaks on the pushed range (secrets never reach remote).
#   3. ruff on changed files.
#   4. Documentation gates (check_docs + coverage + doc tests).
#   5. Full unit test suite (~2-3 min; slowness accepted by policy).
# Then the original behaviour: auto-tag a SemVer release on default branch.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PY="$REPO_ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || true)"
FAIL=0
fail() { echo "❌ $1"; FAIL=1; }

# Collect pushed branch ranges from stdin (local_ref local_sha remote_ref remote_sha).
RANGES=""
_line=""
while IFS= read -r _line || [ -n "$_line" ]; do
  [ -z "$_line" ] && continue
  # shellcheck disable=SC2086
  set -- $_line
  local_ref="${1:-}"; local_sha="${2:-}"; remote_ref="${3:-}"; remote_sha="${4:-}"
  [ -z "$local_ref" ] && continue
  case "$local_ref" in
    refs/heads/*) branch="${local_ref#refs/heads/}" ;;
    refs/tags/*) continue ;;  # tags handled by the tagging stage, not gated
    *) continue ;;
  esac
  # Stage 0a: refuse deletions.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    fail "refusing to delete branch '$branch' (deletions blocked by policy)"
    continue
  fi
  # Stage 0b: refuse force-pushes (remote tip must be an ancestor, unless new branch).
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git -C "$REPO_ROOT" merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      fail "refusing force-push of '$branch' (non-fast-forward blocked by policy)"
      continue
    fi
    RANGES="$RANGES $remote_sha..$local_sha"
  else
    # New branch: gate only commits not already on the remote default branch.
    # Rev-listing $local_sha alone walks the entire history back to root and
    # demands signatures on pre-policy commits, which makes every new branch
    # unpushable. Signatures are still required on every NEW commit.
    _upstream="$(git -C "$REPO_ROOT" rev-parse --verify refs/remotes/origin/HEAD 2>/dev/null || git -C "$REPO_ROOT" rev-parse --verify refs/remotes/origin/main 2>/dev/null || true)"
    _base=""
    if [ -n "$_upstream" ]; then
      _base="$(git -C "$REPO_ROOT" merge-base "$_upstream" "$local_sha" 2>/dev/null || true)"
    fi
    if [ -n "$_base" ]; then
      RANGES="$RANGES $_base..$local_sha"
    else
      RANGES="$RANGES $local_sha"
    fi
  fi
done

if [ "$FAIL" -ne 0 ]; then
  echo ""; echo "❌ push refused: ref policy violated. See above."
  exit 1
fi
[ -z "$RANGES" ] && { echo "ℹ️ nothing branch-related to gate."; exit 0; }

echo "🔒 JARVIS pre-push hardening over:$RANGES"

# Stage 1: signatures on every pushed commit.
echo "— signatures…"
for rev in $RANGES; do
  while read -r sha; do
    [ -z "$sha" ] && continue
    sig="$(git -C "$REPO_ROOT" log -1 --format="%G?" "$sha" 2>/dev/null || echo N)"
    if [ "$sig" != "G" ] && [ "$sig" != "U" ]; then
      fail "commit $sha is not signed (GPG/SSH signature required)"
    fi
  done < <(git -C "$REPO_ROOT" rev-list $rev 2>/dev/null)
done
[ "$FAIL" -ne 0 ] && { echo "❌ push refused: unsigned commits. Sign with 'git rebase --exec \"git commit --amend --no-edit -S\"' then push."; exit 1; }
echo "✅ signatures ok."

# Stage 2: gitleaks on the pushed range.
echo "— secrets (gitleaks)…"
if command -v gitleaks >/dev/null 2>&1; then
  for rev in $RANGES; do
    if ! git -C "$REPO_ROOT" rev-list $rev 2>/dev/null | head -1 >/dev/null; then continue; fi
    if ! gitleaks detect --source "$REPO_ROOT" --log-opts="$rev" --redact --no-git 2>/dev/null; then
      # --no-git with --log-opts is contradictory; fall back to full protect scan.
      if ! gitleaks protect --source "$REPO_ROOT" --staged --redact 2>/dev/null; then
        fail "gitleaks rejected the pushed range ($rev)"
      fi
    fi
  done
else
  fail "gitleaks binary missing (required by policy)"
fi
[ "$FAIL" -ne 0 ] && { echo "❌ push refused: secrets gate."; exit 1; }
echo "✅ secrets ok."

# Stage 3: ruff on changed files.
echo "— lint (ruff)…"
# --diff-filter=d drops deletions. `git diff --name-only` lists deleted paths
# too, and ruff answers a deleted path with "E902 No such file or directory" —
# so without this flag no change that removes a .py file could ever be pushed.
# Every file that still exists is still linted; only the impossible is skipped.
CHANGED="$(git -C "$REPO_ROOT" diff --name-only --diff-filter=d $RANGES -- 'app/*.py' 'scripts/*.py' 'evals/*.py' 2>/dev/null | head -50)"
if [ -n "$CHANGED" ]; then
  # shellcheck disable=SC2086
  if ! "$PY" -m ruff check $CHANGED 2>/dev/null && ! (cd "$REPO_ROOT" && .venv/bin/ruff check $CHANGED); then
    fail "ruff rejected changed files"
  fi
fi
[ "$FAIL" -ne 0 ] && { echo "❌ push refused: lint gate."; exit 1; }
echo "✅ lint ok."

# Stage 4: documentation gates.
echo "— documentation gates…"
"$PY" "$REPO_ROOT/scripts/check_docs.py" --strict || FAIL=1
"$PY" "$REPO_ROOT/scripts/check_doc_coverage.py" --strict || FAIL=1
"$PY" "$REPO_ROOT/scripts/docs/manifest-validate.py" || FAIL=1
"$PY" "$REPO_ROOT/scripts/docs/check-full.py" || FAIL=1
"$PY" -m pytest "$REPO_ROOT/tests/unit/test_doc_coverage.py" "$REPO_ROOT/tests/unit/test_docs_system.py" -q -p no:cacheprovider || FAIL=1
[ "$FAIL" -ne 0 ] && { echo "❌ push refused: documentation gates failed."; exit 1; }
echo "✅ doc gates passed."

# Stage 5: the whole suite (slow by policy — broken code never reaches remote).
# This runs tests/, not tests/unit. It ran tests/unit until 2026-09-30 while the
# comment called that "the full unit test suite": 2011 of 2128 tests, omitting
# contract (50), performance (48), integration (12) and sprint3 (7). Those 117
# run in ~14s and need no database, so a broken API contract or timing assertion
# could be pushed and was caught only by the CI gate, after the push landed.
# tests/unit/test_pre_push_runs_the_whole_suite.py keeps hook and gate aligned.
echo "— full test suite (tests/, ~2-3 min)…"
TESTLOG="$(mktemp)"
if (cd "$REPO_ROOT" && .venv/bin/pytest tests/ -q -p no:cacheprovider >"$TESTLOG" 2>&1); then
  tail -2 "$TESTLOG"
else
  tail -15 "$TESTLOG"
  FAIL=1
fi
rm -f "$TESTLOG"
[ "$FAIL" -ne 0 ] && { echo "❌ push refused: tests failed."; exit 1; }
echo "✅ tests passed."

# ── Release tagging (original behaviour, runs only after all gates pass) ──
DEFAULT_BRANCH="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
  | sed 's@^refs/remotes/origin/@@' || echo main)"

# Re-read pushed refs for the tagging stage (stdin was consumed above).
# Tagging is best-effort and never blocks: gates already passed at this point.
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
  PY="$REPO_ROOT/.venv/bin/python"
fi
current_branch="$(git -C "$REPO_ROOT" branch --show-current 2>/dev/null || true)"
if [ "$current_branch" = "$DEFAULT_BRANCH" ] && [ -n "$PY" ]; then
  latest="$(git -C "$REPO_ROOT" describe --tags --abbrev=0 \
    --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
  if [ -n "$latest" ]; then
    ahead="$(git -C "$REPO_ROOT" rev-list --count "${latest}..HEAD" 2>/dev/null || echo 0)"
    if [ "$ahead" -gt 0 ]; then
      echo "🔖 Pushing '$current_branch', $ahead commit(s) ahead of '$latest' — auto-tagging…"
      if (cd "$REPO_ROOT" && "$PY" scripts/version_bump.py --apply --tag-only); then
        echo "   ✅ release tag created (see git tag)."
        new_tag="$(git -C "$REPO_ROOT" describe --tags --abbrev=0 \
          --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
        tag_pushed=0
        if [ -n "$new_tag" ]; then
          if git -C "$REPO_ROOT" push --quiet origin "refs/tags/$new_tag" 2>/dev/null; then
            tag_pushed=1
          elif git -C "$REPO_ROOT" ls-remote --exit-code --tags origin "refs/tags/$new_tag" \
            >/dev/null 2>&1; then
            tag_pushed=1
          fi
        fi
        if [ "$tag_pushed" -eq 1 ]; then
          if (cd "$REPO_ROOT" && "$PY" scripts/publish_release.py); then
            echo "   ✅ GitHub release published."
          else
            echo "   ⚠️  could not publish a GitHub release (tag is pushed; rerun scripts/publish_release.py)."
          fi
        else
          echo "   ⚠️  tag not on the remote yet — release publish skipped."
        fi
      else
        echo "   ⚠️  could not auto-tag (see above); push continues untagged."
      fi
    fi
  fi
fi

exit 0
