#!/usr/bin/env bash
# JARVIS pre-push hook — remind to cut a release tag when pushing main ahead
# of the latest vA.B.C tag. Informational only (never blocks the push).
#
# Installed via:  python scripts/bump_version.py install-hooks
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
DEFAULT_BRANCH="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
  | sed 's@^refs/remotes/origin/@@' || echo main)"

while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  branch="${local_ref#refs/heads/}"
  # Only warn for the default (main) branch.
  [ "$branch" = "$DEFAULT_BRANCH" ] || continue

  latest="$(git -C "$REPO_ROOT" describe --tags --abbrev=0 \
    --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
  [ -n "$latest" ] || continue

  ahead="$(git -C "$REPO_ROOT" rev-list --count "${latest}..HEAD" 2>/dev/null || echo 0)"
  dirty="$(git -C "$REPO_ROOT" status --porcelain | head -n1)"

  if [ "$ahead" -gt 0 ] || [ -n "$dirty" ]; then
    echo "⚠️  Pushing '$branch', which is $ahead commit(s) ahead of release tag '$latest'."
    if [ -n "$dirty" ]; then
      echo "    Working tree is dirty — the derived version will be flagged '.dirty'."
    fi
    echo "    To cut a release:  python scripts/bump_version.py patch|minor|major"
  fi
done

exit 0
