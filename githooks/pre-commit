#!/usr/bin/env bash
# JARVIS pre-commit hook — keep versioning automatic (git-derived, never hardcoded).
#
# Installed via:  python scripts/bump_version.py install-hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_ROOT/app/config/version.py"

# 1) Guard: refuse to commit a hardcoded literal version in the version module.
#    The version MUST be derived from git tags (vA.B.C), not written by hand.
if [ -f "$VERSION_FILE" ]; then
  if grep -Eq '^VERSION[[:space:]]*=[[:space:]]*["'"'"']v[0-9]' "$VERSION_FILE"; then
    echo "❌ app/config/version.py must derive VERSION from git, not hardcode it."
    echo "   Remove the literal 'VERSION = \"v...\"' assignment."
    exit 1
  fi
fi

# 2) Show the version git will derive for this tree.
if command -v python3 >/dev/null 2>&1; then
  python3 - "$REPO_ROOT" <<'PY' || true
import sys, subprocess
root = sys.argv[1]
cmd = (
    "import sys; sys.path.insert(0, sys.argv[1]); "
    "from app.config.version import VERSION, VERSION_SOURCE; "
    "print(f'{VERSION} (source={VERSION_SOURCE})')"
)
try:
    out = subprocess.run([sys.executable, "-c", cmd, root],
                         capture_output=True, text=True, cwd=root)
    if out.returncode == 0 and out.stdout.strip():
        print(f"🔖 JARVIS version: {out.stdout.strip()}")
except Exception:
    pass
PY
fi

# 3) Keep doc facts true to the code. Documents do not store numbers; they cite
#    a fact name that is re-derived here, so "22 checks" cannot survive gate 23.
#    --apply rewrites the marked values and we re-stage, so the corrected docs
#    ride along in the same commit as the change that made them stale.
if [ -x "$REPO_ROOT/.venv/bin/python" ] && [ -f "$REPO_ROOT/scripts/sync_doc_facts.py" ]; then
  echo "🔄 Syncing doc facts with the code…"
  "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/sync_doc_facts.py" --apply >/tmp/jarvis_doc_facts.log 2>&1 || true
  # Re-stage only documents the sync actually touched.
  git diff --name-only -- docs '*.md' | while IFS= read -r f; do
    [ -n "$f" ] && git add -- "$f"
  done
  echo "   $(tail -1 /tmp/jarvis_doc_facts.log)"
fi

# 3b) Keep the documented type contract identical to scripts/doc_types.py. The
#     §10 tables in DOC-GOVERNANCE.md are generated; if an author adds or changes
#     a type, this regenerates the documentation in the same commit so the doc can
#     never describe a contract the code does not implement.
if [ -x "$REPO_ROOT/.venv/bin/python" ] && [ -f "$REPO_ROOT/scripts/doc_type_table.py" ]; then
  "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/doc_type_table.py" --write >/dev/null 2>&1 || true
  if ! git diff --quiet -- docs/DOC-GOVERNANCE.md; then
    git add -- docs/DOC-GOVERNANCE.md
    echo "📚 Regenerated the doc-type contract tables in docs/DOC-GOVERNANCE.md"
  fi
fi

# 4) Run the pre-commit framework on STAGED files (ratchet): new/changed code must
#    be clean even while legacy debt is burned down. mypy is excluded here until the
#    legacy type backlog is cleared — tracked as RISK-005 in docs/ACCEPTED_RISKS.md.
if [ -x "$REPO_ROOT/.venv/bin/pre-commit" ]; then
  echo "🔍 Running pre-commit framework (staged files)…"
  SKIP=mypy "$REPO_ROOT/.venv/bin/pre-commit" run || {
    echo "❌ pre-commit failed. Re-stage auto-fixes or fix the reported issues."
    exit 1
  }
fi

# 5) Backstop: refuse the commit if any doc still contradicts the repository.
if [ -x "$REPO_ROOT/.venv/bin/python" ] && [ -f "$REPO_ROOT/scripts/sync_doc_facts.py" ]; then
  if ! "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/sync_doc_facts.py" --check >/tmp/jarvis_doc_facts_check.log 2>&1; then
    echo "❌ Documentation contradicts the code:"
    grep -E '^\s+-' /tmp/jarvis_doc_facts_check.log | head -20
    echo "   Fix with: .venv/bin/python scripts/sync_doc_facts.py --apply"
    exit 1
  fi
fi

exit 0
