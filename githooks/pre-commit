#!/usr/bin/env bash
# JARVIS pre-commit hook — keep versioning automatic (git-derived, never hardcoded).
#
# Installed via:  python scripts/bump_version.py install-hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_ROOT/app/config/version.py"

# 1) Guard: refuse to commit a hardcoded literal version in the version module.
#    The version MUST be derived from git tags (vA.B.C), not written by hand.
if [ -f "$VERSION_FILE" ]; then
  if grep -Eq '^VERSION[[:space:]]*=[[:space:]]*["'"'"']v[0-9]' "$VERSION_FILE"; then
    echo "❌ app/config/version.py must derive VERSION from git, not hardcode it."
    echo "   Remove the literal 'VERSION = \"v...\"' assignment."
    exit 1
  fi
fi

# 2) Show the version git will derive for this tree.
if command -v python3 >/dev/null 2>&1; then
  python3 - "$REPO_ROOT" <<'PY' || true
import sys, subprocess
root = sys.argv[1]
cmd = (
    "import sys; sys.path.insert(0, sys.argv[1]); "
    "from app.config.version import VERSION, VERSION_SOURCE; "
    "print(f'{VERSION} (source={VERSION_SOURCE})')"
)
try:
    out = subprocess.run([sys.executable, "-c", cmd, root],
                         capture_output=True, text=True, cwd=root)
    if out.returncode == 0 and out.stdout.strip():
        print(f"🔖 JARVIS version: {out.stdout.strip()}")
except Exception:
    pass
PY
fi

# 3) Doc facts are true — and a BRANCH may not write them.
#
#    Documents do not store numbers; they cite a fact name that is re-derived
#    here, so "22 checks" cannot survive gate 23.
#
#    WHAT WENT WRONG, because this hook was the cause and not a bystander: it
#    ran `--sync`/`--apply` on EVERY commit, so every branch rewrote the marker
#    lines. A marker value is a function of the working tree, so a branch's value
#    differs from main's the moment the branch changes a count -- and main
#    advances on its own. Both sides therefore changed the same lines and git
#    reported a conflict: structurally, on every test-adding PR, every dependency
#    PR and every ADR. (No .gitattributes driver can fix that: GitHub computes
#    mergeability itself and does not run merge drivers -- measured, not assumed.)
#
#    So the rule is now: a branch must NEVER modify a fact marker line; only the
#    default branch may. On the default branch this stage still syncs, verifies
#    and re-stages, exactly as before. On any other branch it writes NOTHING: it
#    checks the marker lines against the base branch (blocking -- that is the
#    invariant, enforced at commit time) and reports which values are stale
#    relative to this tree (advisory -- on a branch that is the expected state,
#    because the markers describe the published repository, not the proposal).
#
#    `DOC_FACTS_REFRESH=1` is the one sanctioned exception: the main-side refresh
#    path, which exists precisely to be main's writer of those lines
#    (.github/workflows/doc-facts-refresh.yml).
#
#    See state/DECISIONS.md ADR-008 and docs/adr/ADR-014-*.md.
if [ -x "$REPO_ROOT/.venv/bin/python" ] && [ -f "$REPO_ROOT/scripts/sync_doc_facts.py" ]; then
  FACTS_CACHE="$REPO_ROOT/.governance/doc_facts.json"
  DOC_FACTS_LOG=/tmp/jarvis_doc_facts.log
  rc=0
  if [ -f "$FACTS_CACHE" ]; then
    # Fast path: reuse the gate's measured facts (no pytest run). Only the
    # default branch can act on them; a branch never writes.
    "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/sync_doc_facts.py" --pre-commit \
      --facts-json "$(cat "$FACTS_CACHE")" >"$DOC_FACTS_LOG" 2>&1 || rc=$?
  else
    "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/sync_doc_facts.py" --pre-commit \
      >"$DOC_FACTS_LOG" 2>&1 || rc=$?
  fi
  cat "$DOC_FACTS_LOG"
  if [ "$rc" -ne 0 ]; then
    echo "❌ Commit refused: documentation facts. See state/DECISIONS.md ADR-008."
    exit 1
  fi
  # Re-stage only documents the sync actually touched. On a branch nothing was
  # written, so this is a no-op there — and that is the point.
  git diff --name-only -- docs '*.md' | while IFS= read -r f; do
    [ -n "$f" ] && git add -- "$f"
  done
fi

# 3b) Keep the documented type contract identical to scripts/doc_types.py. The
#     §10 tables in DOC-GOVERNANCE.md are generated; if an author adds or changes
#     a type, this regenerates the documentation in the same commit so the doc can
#     never describe a contract the code does not implement.
if [ -x "$REPO_ROOT/.venv/bin/python" ] && [ -f "$REPO_ROOT/scripts/doc_type_table.py" ]; then
  "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/doc_type_table.py" --write >/dev/null 2>&1 || true
  if ! git diff --quiet -- docs/DOC-GOVERNANCE.md; then
    git add -- docs/DOC-GOVERNANCE.md
    echo "📚 Regenerated the doc-type contract tables in docs/DOC-GOVERNANCE.md"
  fi
fi

# 3c) The documentation gate, at COMMIT time.
#
#     docs/DOC-GOVERNANCE.md §10.1 step 5 already states that check_docs
#     "is enforced again by githooks/pre-commit". It was not: this hook ran the
#     fact sync and the type-table sync, but never the checker itself, so a
#     document that violates its type contract could be committed and was only
#     rejected at push. The governance document named a process that did not
#     exist -- the exact drift trap its own `governance` type warns about.
#
#     Wiring it here is what makes that sentence true. It costs ~0.5s because
#     check_docs walks the tree with rglob, so it covers NEW and untracked
#     documents as well as modified ones: a document added without a `**Type**`
#     header, or one no other document links to, now fails at commit instead of
#     surviving until a reader notices the gap in docs/README.md. Manifest
#     classification is enforced by
#     tests/unit/test_docs_system.py::test_manifest_covers_whole_tree, which the
#     pre-push hook runs in its documentation stage.
if [ -x "$REPO_ROOT/.venv/bin/python" ] && [ -f "$REPO_ROOT/scripts/check_docs.py" ]; then
  echo "📖 Checking documentation structure and type contract…"
  if ! "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/scripts/check_docs.py" --strict; then
    echo "❌ Commit refused: documentation gate. See docs/DOC-GOVERNANCE.md §10."
    exit 1
  fi
  echo "✅ doc gate ok."
fi

# 4) Run the pre-commit framework on STAGED files (ratchet): new/changed code must
#    be clean even while legacy debt is burned down. mypy is excluded here until the
#    legacy type backlog is cleared — tracked as RISK-005 in docs/ACCEPTED_RISKS.md.
if [ -x "$REPO_ROOT/.venv/bin/pre-commit" ]; then
  echo "🔍 Running pre-commit framework (staged files)…"
  SKIP=mypy "$REPO_ROOT/.venv/bin/pre-commit" run || {
    echo "❌ pre-commit failed. Re-stage auto-fixes or fix the reported issues."
    exit 1
  }
fi



exit 0
